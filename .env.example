# Local law app works without an Appofa connection. Set true to also run remote tasks.
WORKER_ENABLED=false

# Serve the read-only LawDB reader to verified Appofa members over the worker connection.
# In Appofa's Worker Status settings, allow Legal Library access for this worker's token.
LAW_LIBRARY_SHARE=false

# Local Neo4j database is managed by Appofasistis (npm run db:setup).
# Credentials are generated locally in ignored .runtime/credentials.json.
# To use an existing LOCAL instance, configure:
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-local-password
# NEO4J_DATABASE=neo4j
# LEGAL_DATA_DIR=C:/path/to/local-files

# Optional Appofa server WebSocket URL
SERVER_URL=wss://appofasi.gr/ws/workers

# Worker authentication token (get from Appofa admin panel)
WORKER_TOKEN=your-worker-token-here

# Unique worker ID used for multi-worker deployments (default: machine hostname)
WORKER_ID=my-desktop-worker-1

# Internal API port for health + snapshots endpoints (default: 3001)
INTERNAL_API_PORT=3001

# Worker name (shown in admin dashboard)
WORKER_NAME=my-desktop

# Max concurrent tasks this worker will accept (default: 3)
MAX_CONCURRENT_TASKS=3

# Heartbeat interval in ms (default: 10000)
HEARTBEAT_INTERVAL=10000

# Reconnect delay in ms (default: 5000)
RECONNECT_DELAY=5000

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
