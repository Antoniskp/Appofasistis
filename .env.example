# Appofa server WebSocket URL
SERVER_URL=wss://appofasi.gr/ws/workers

# Worker authentication token (get from Appofa admin panel)
WORKER_TOKEN=your-worker-token-here

# Worker name (shown in admin dashboard)
WORKER_NAME=my-desktop

# Max concurrent tasks this worker will accept (default: 3)
MAX_CONCURRENT_TASKS=3

# Heartbeat interval in ms (default: 10000)
HEARTBEAT_INTERVAL=10000

# Reconnect delay in ms (default: 5000)
RECONNECT_DELAY=5000

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
